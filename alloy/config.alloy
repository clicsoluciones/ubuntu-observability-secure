// Host metrics -> Prometheus remote_write
prometheus.exporter.unix "host_ubuntu" {
	enable_collectors = ["meminfo", "netstat", "conntrack", "softnet", "systemd", "processes", "textfile"]

	textfile {
		directory = "/var/lib/alloy/textfile"
	}

	filesystem {
		fs_types_exclude = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|overlay|proc|sysfs|tracefs)$"
	}
}

// Process metrics -> TOP processes by CPU & Memory
// Optimized to match key system and application services without high-cardinality explosion
prometheus.exporter.process "top_processes" {
	track_children      = false
	remove_empty_groups = true

	matcher {
		name = "nginx"
		comm = ["nginx"]
	}

	matcher {
		name = "dockerd"
		comm = ["dockerd", "containerd", "docker-proxy"]
	}

	matcher {
		name = "php-fpm"
		comm = ["php-fpm", "php-fpm8.1", "php-fpm8.2", "php-fpm8.3"]
	}

	matcher {
		name = "node"
		comm = ["node", "bun", "deno"]
	}

	matcher {
		name = "python"
		comm = ["python", "python3", "gunicorn", "uvicorn"]
	}

	matcher {
		name = "database"
		comm = ["mysqld", "mariadbd", "postgres", "redis-server", "mongod"]
	}

	matcher {
		name = "java"
		comm = ["java"]
	}

	matcher {
		name = "observability"
		comm = ["grafana-server", "loki", "prometheus", "alloy", "crowdsec"]
	}

	matcher {
		name = "system"
		comm = ["systemd", "sshd", "rsyslogd", "auditd", "ufw"]
	}
}

prometheus.scrape "host_metrics" {
	scrape_interval = "15s"
	targets         = concat(prometheus.exporter.unix.host_ubuntu.targets, prometheus.exporter.process.top_processes.targets)
	forward_to      = [prometheus.remote_write.local_prom.receiver]
}

// Scrape CrowdSec Prometheus metrics endpoint on loopback port 6060
prometheus.scrape "crowdsec_metrics" {
	scrape_interval = "15s"
	targets = [
		{"__address__" = "127.0.0.1:6060", "job" = "crowdsec", "instance" = constants.hostname},
	]
	forward_to = [prometheus.remote_write.local_prom.receiver]
}

prometheus.remote_write "local_prom" {
	endpoint {
		url = "http://127.0.0.1:9090/api/v1/write"
	}
}

// Read Ubuntu auth, UFW, CrowdSec, and all Nginx virtual host access/error logs.
// Missing files or patterns are simply not tailed until created.
local.file_match "security_and_web_logs" {
	path_targets = [
		{__path__ = "/var/log/auth.log", job = "ssh_auth", host = constants.hostname},
		{__path__ = "/var/log/ufw.log", job = "ufw_firewall", host = constants.hostname},
		{__path__ = "/var/log/crowdsec.log", job = "crowdsec_ips", host = constants.hostname},
		{__path__ = "/var/log/nginx/*access*.log", job = "nginx_access", host = constants.hostname},
		{__path__ = "/var/log/nginx/*error*.log", job = "nginx_error", host = constants.hostname},
	]
}

loki.source.file "log_scraper" {
	targets    = local.file_match.security_and_web_logs.targets
	forward_to = [loki.write.local_loki.receiver]
}

// Discover and collect Docker container logs (stdout access logs & stderr error logs)
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "docker_apps" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.docker_logs.output
	labels     = {
		job  = "docker_containers",
		host = constants.hostname,
	}
	forward_to = [loki.write.local_loki.receiver]
}

loki.source.journal "systemd_journal" {
	forward_to = [loki.write.local_loki.receiver]
	labels     = {
		job  = "systemd_journal",
		host = constants.hostname,
	}
}

loki.write "local_loki" {
	endpoint {
		url = "http://127.0.0.1:3100/loki/api/v1/push"
	}
}
